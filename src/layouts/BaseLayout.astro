---
import Header from '../components/Header.astro';
import { site } from '../site';
import '../global.css';
interface Props { title?: string; description?: string; image?: string; article?: boolean; publishedAt?: string; updatedAt?: string; noindex?: boolean; }
const { title, description = site.description, image = site.avatar, article = false, publishedAt, updatedAt, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · 学习与生活`;
const canonical = new URL(Astro.url.pathname === '/index.html' ? '/' : Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let preference;
        try { preference = localStorage.getItem('hiwz-theme'); } catch {}
        root.dataset.theme = preference === 'light' || preference === 'dark'
          ? preference : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} 的文章`} href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedAt && <meta property="article:published_time" content={`${publishedAt}T00:00:00+08:00`} />}
    {updatedAt && <meta property="article:modified_time" content={`${updatedAt}T00:00:00+08:00`} />}
  </head>
  <body class="antialiased">
    <a class="skip-link" href="#main-content">跳到正文</a>
    <Header />
    <main id="main-content"><slot /></main>
    <footer class="site-footer"><div class="mx-auto flex max-w-6xl flex-col items-center gap-2 px-6 py-8 text-center text-sm leading-5">
      <span>© {new Date().getUTCFullYear()} <a href="/">{site.name}</a></span>
      <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">{site.icp}</a>
    </div></footer>
  </body>
</html>
