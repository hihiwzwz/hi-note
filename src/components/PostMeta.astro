---
import { categoryName } from '../site';
import { formatDate, readingMinutes, type Post } from '../posts';
interface Props { post: Post; showCategory?: boolean; }
const { post, showCategory = false } = Astro.props;
---
<div class="post-meta flex flex-wrap items-center gap-x-4 gap-y-1 text-base leading-6">
  {post.data.publishedAt && <time datetime={post.data.publishedAt}>{formatDate(post.data.publishedAt)}</time>}
  <span>阅读需{readingMinutes(post.body)}分钟</span>
  {showCategory && <a href={`/categories/${post.data.category}/`}>{categoryName(post.data.category)}</a>}
</div>
